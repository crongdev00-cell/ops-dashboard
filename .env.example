GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
GEMINI_MODEL=gemini-3.5-flash-lite

# BASE_URL에는 서버 기본 주소만 넣으면 됩니다 (예: https://사내주소/llm_api/gemma-4-31B-it) —
# /v1/chat/completions는 자동으로 붙습니다. 이미 완전한 엔드포인트 주소를 알고 있다면 API_URL에 넣으세요(우선 적용).
GEMMA_API_KEY=
GEMMA_API_BASE_URL=
GEMMA_API_URL=
GEMMA_MODEL=gemma-4-31B-it
GEMMA_THINKING=false
GEMMA_MAX_TOKENS=100000

EXAONE_API_KEY=
EXAONE_API_BASE_URL=
EXAONE_API_URL=
EXAONE_MODEL=EXAONE-4.5-33B
EXAONE_THINKING=false
EXAONE_MAX_TOKENS=262144
